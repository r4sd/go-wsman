<?xml version="1.0" encoding="UTF-8"?>
<!--
  実機 Hyper-V (Windows Server) が返す xsi:nil="true" の形を再現したもの。

  1 件目 (vm-real): 2026-09-14 に実機の Msvm_ResourceAllocationSettingData 応答から採取。
    NULL スカラープロパティは <p:Parent xsi:nil="true"/> の形で **要素は出る**。
    調査した 570 応答のうち 531 応答がこの形を含んでいた。

  2 件目 (vm-synthetic): **合成データ**。配列の途中に NULL が入る形
    (<p:Subnets xsi:nil="true"/> が要素の間に挟まる) は実機で未観測のため、
    位置保持の回帰テスト用に手で作った。実機がこの形を返す証拠は無い。
-->
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:w="http://schemas.dmtf.org/wbem/wsman/1/wsman.xsd" xmlns:e="http://schemas.xmlsoap.org/ws/2004/09/enumeration" xmlns:p="http://schemas.microsoft.com/wbem/wsman/1/wmi/root/virtualization/v2/Msvm_VirtualSystemSettingData">
  <s:Header>
    <a:Action>http://schemas.xmlsoap.org/ws/2004/09/enumeration/PullResponse</a:Action>
    <a:MessageID>uuid:response-pull-xsinil-001</a:MessageID>
  </s:Header>
  <s:Body>
    <e:PullResponse>
      <e:Items>
        <p:Msvm_VirtualSystemSettingData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <p:ElementName>vm-real</p:ElementName>
          <p:Parent xsi:nil="true"/>
          <p:Address xsi:nil="true"/>
          <p:AutomaticStartupActionSequenceNumber xsi:nil="true"/>
          <p:VirtualQuantity>2</p:VirtualQuantity>
        </p:Msvm_VirtualSystemSettingData>
        <p:Msvm_VirtualSystemSettingData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <p:ElementName>vm-synthetic</p:ElementName>
          <p:IPAddresses>192.0.2.10</p:IPAddresses>
          <p:IPAddresses>2001:db8::10</p:IPAddresses>
          <p:Subnets>255.255.255.0</p:Subnets>
          <p:Subnets xsi:nil="true"/>
          <p:DNSServers xsi:nil="true"/>
          <p:DNSServers>192.0.2.1</p:DNSServers>
        </p:Msvm_VirtualSystemSettingData>
      </e:Items>
      <e:EnumerationContext>uuid:context-xsinil</e:EnumerationContext>
    </e:PullResponse>
  </s:Body>
</s:Envelope>
