<?xml version="1.0" encoding="UTF-8"?>
<!--
  CreateSnapshot の非同期応答 (ReturnValue=4096)。

  実機は 4096 のとき ResultingSnapshot を返さない (2026-08-01 実機確認)。
  MOF 上 ResultingSnapshot は [in, out] だが、メソッド応答の時点ではまだ
  スナップショットが確定していないため空で返る。ここに値入りの
  ResultingSnapshot を書くと実機に存在しない挙動を仕様として固定してしまうので
  書かない (#125 で追跡)。
-->
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:p="http://schemas.microsoft.com/wbem/wsman/1/wmi/root/virtualization/v2/Msvm_VirtualSystemSnapshotService">
  <s:Header>
    <a:Action>http://schemas.microsoft.com/wbem/wsman/1/wmi/root/virtualization/v2/Msvm_VirtualSystemSnapshotService/CreateSnapshotResponse</a:Action>
    <a:MessageID>uuid:response-create-snapshot-001</a:MessageID>
  </s:Header>
  <s:Body>
    <p:CreateSnapshot_OUTPUT>
      <p:Job>
        <a:EndpointReference>
          <a:Address>http://schemas.xmlsoap.org/ws/2004/08/addressing/role/anonymous</a:Address>
          <a:ReferenceParameters>
            <w:ResourceURI xmlns:w="http://schemas.dmtf.org/wbem/wsman/1/wsman.xsd">http://schemas.microsoft.com/wbem/wsman/1/wmi/root/virtualization/v2/Msvm_ConcreteJob</w:ResourceURI>
            <w:SelectorSet xmlns:w="http://schemas.dmtf.org/wbem/wsman/1/wsman.xsd">
              <w:Selector Name="InstanceID">1A2B3C4D-5555-6666-7777-888899990000</w:Selector>
            </w:SelectorSet>
          </a:ReferenceParameters>
        </a:EndpointReference>
      </p:Job>
      <p:ReturnValue>4096</p:ReturnValue>
    </p:CreateSnapshot_OUTPUT>
  </s:Body>
</s:Envelope>
