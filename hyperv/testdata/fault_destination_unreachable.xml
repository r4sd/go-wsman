<?xml version="1.0" encoding="UTF-8"?>
<!-- 不在リソースへの Get が返す WS-Man Fault。Job が既に存在しない/URI 不一致の再現に使う。 -->
<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:w="http://schemas.dmtf.org/wbem/wsman/1/wsman.xsd">
  <s:Header>
    <a:Action>http://schemas.dmtf.org/wbem/wsman/1/wsman/fault</a:Action>
  </s:Header>
  <s:Body>
    <s:Fault>
      <s:Code>
        <s:Value>s:Sender</s:Value>
        <s:Subcode>
          <s:Value>a:DestinationUnreachable</s:Value>
        </s:Subcode>
      </s:Code>
      <s:Reason>
        <s:Text xml:lang="ja-JP">WS-Management サービスは要求を処理できません。サービスはリソース URI およびセレクターによって識別されたリソースを見つけられません。</s:Text>
      </s:Reason>
    </s:Fault>
  </s:Body>
</s:Envelope>
