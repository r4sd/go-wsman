          <p:CreationClassName>Msvm_ExternalEthernetPort</p:CreationClassName>
          <p:SystemCreationClassName>Msvm_ComputerSystem</p:SystemCreationClassName>
          <p:SystemName>HOST-EXAMPLE</p:SystemName>
          <p:PermanentAddress>00155D000002</p:PermanentAddress>
          <p:EnabledState>2</p:EnabledState>
          <p:IsBound>true</p:IsBound>
        </p:Msvm_ExternalEthernetPort>
      </e:Items>
      <e:EndOfSequence/>
    </e:PullResponse>
  </s:Body>
</s:Envelope>
