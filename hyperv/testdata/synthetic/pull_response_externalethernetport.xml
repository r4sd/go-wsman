  </s:Header>
  <s:Body>
    <e:PullResponse>
      <e:Items>
        <p:Msvm_ExternalEthernetPort>
          <p:Name>Realtek Gaming 2.5GbE</p:Name>
          <p:ElementName>Realtek Gaming 2.5GbE</p:ElementName>
          <p:DeviceID>Microsoft:{CCCCCCCC-3333-3333-3333-CCCCCCCCCCCC}</p:DeviceID>
          <p:CreationClassName>Msvm_ExternalEthernetPort</p:CreationClassName>
          <p:SystemCreationClassName>Msvm_ComputerSystem</p:SystemCreationClassName>
          <p:SystemName>HOST-EXAMPLE</p:SystemName>
          <p:PermanentAddress>00155D000001</p:PermanentAddress>
          <p:EnabledState>2</p:EnabledState>
          <p:IsBound>false</p:IsBound>
        </p:Msvm_ExternalEthernetPort>
